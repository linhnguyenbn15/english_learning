                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="flex items-center justify-between text-slate-500 mb-2">
                            <span class="text-xs font-semibold uppercase">Practices Done</span>
                            <i class="fa-solid fa-check-double text-blue-500"></i>
                        </div>
                        <p class="text-2xl font-bold text-slate-800" id="statCompletedTasks">0</p>
                        <p class="text-xs text-slate-500 mt-1">Completed sessions</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
                        <div class="flex items-center justify-between text-slate-500 mb-2">
                            <span class="text-xs font-semibold uppercase">Weak Skill Focus</span>
                            <i class="fa-solid fa-bullseye text-amber-500"></i>
                        </div>
                        <p class="text-2xl font-bold text-slate-800" id="statWeakness">None</p>
                        <p class="text-xs text-slate-500 mt-1">Identified from tests</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                        <h3 class="text-base font-bold text-slate-800 mb-4">4-Skill Proficiency Breakdown</h3>
                        <div class="h-64"><canvas id="skillsRadarChart"></canvas></div>
                    </div>
                    <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                        <h3 class="text-base font-bold text-slate-800 mb-3">6-Month Target Roadmap</h3>
                        <div class="space-y-4 text-sm">
                            <div class="p-3 rounded-lg bg-indigo-50 border-l-4 border-indigo-600">
                                <p class="font-semibold text-indigo-900">Months 1-3: Target B2</p>
                                <p class="text-xs text-indigo-700 mt-0.5">Focus: TOEIC Business Reading/Listening, Translation drills, General Corporate & HR terms.</p>
                            </div>
                            <div class="p-3 rounded-lg bg-slate-50 border-l-4 border-slate-300">
                                <p class="font-semibold text-slate-800">Months 4-6: Target C1</p>
                                <p class="text-xs text-slate-600 mt-0.5">Focus: Advanced Executive Negotiations, Complex Audits, Strategic Reports.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. DAILY PRACTICE VIEW (5 QUESTIONS PER MODULE) -->
            <section id="view-daily" class="hidden space-y-6">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-2">
                    <button onclick="loadSkillModule('speaking')" id="btn-skill-speaking" class="skill-tab-btn flex-1 min-w-[120px] py-2 px-3 rounded-lg font-medium text-sm border text-slate-700 hover:bg-slate-50">
                        <i class="fa-solid fa-microphone me-2 text-rose-500"></i> Speaking (5 Qs)
                    </button>
                    <button onclick="loadSkillModule('writing')" id="btn-skill-writing" class="skill-tab-btn flex-1 min-w-[120px] py-2 px-3 rounded-lg font-medium text-sm border text-slate-700 hover:bg-slate-50">
                        <i class="fa-solid fa-pen-nib me-2 text-blue-500"></i> Writing & Translation (5 Qs)
                    </button>
                    <button onclick="loadSkillModule('reading')" id="btn-skill-reading" class="skill-tab-btn flex-1 min-w-[120px] py-2 px-3 rounded-lg font-medium text-sm border text-slate-700 hover:bg-slate-50">
                        <i class="fa-solid fa-book-open me-2 text-emerald-500"></i> Reading & Translation (5 Qs)
                    </button>
                    <button onclick="loadSkillModule('listening')" id="btn-skill-listening" class="skill-tab-btn flex-1 min-w-[120px] py-2 px-3 rounded-lg font-medium text-sm border text-slate-700 hover:bg-slate-50">
                        <i class="fa-solid fa-headphones me-2 text-amber-500"></i> Listening Context (5 Qs)
                    </button>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 space-y-6">
                    <div class="flex justify-between items-center pb-3 border-b border-slate-100">
                        <div>
                            <span id="activeSkillBadge" class="text-xs font-bold px-2.5 py-1 rounded-full bg-indigo-100 text-indigo-700 uppercase">Speaking</span>
                            <h3 id="activeTopicTitle" class="text-lg font-bold text-slate-800 mt-1">Advanced 5-Question Set</h3>
                        </div>
                        <span class="text-xs bg-slate-100 text-slate-600 font-semibold px-3 py-1.5 rounded-lg">5 Comprehensive Exercises</span>
                    </div>

                    <!-- 5 Questions Container -->
                    <div id="exerciseWorkspace" class="space-y-8">
                        <!-- Injected via JS -->
                    </div>

                    <button onclick="evaluateAllAnswers()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl shadow-md transition">
                        Submit All 5 Answers for Detailed AI Evaluation
                    </button>

                    <!-- Separated Structured Feedback Container -->
                    <div id="feedbackContainer" class="hidden mt-6 pt-5 border-t-2 border-indigo-100 space-y-4">
                        <h4 class="font-bold text-slate-800 text-base flex items-center">
                            <i class="fa-solid fa-wand-magic-sparkles me-2 text-indigo-600"></i> Detailed AI Assessment Report & Correct Answers
                        </h4>
                        <div id="feedbackContent" class="bg-slate-50 rounded-xl p-5 text-sm text-slate-700 space-y-4 border border-slate-200">
                            <!-- Structured feedback injected here -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. MONTHLY ASSESSMENT VIEW -->
            <section id="view-assessment" class="hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-1">Monthly Competency Assessment</h3>
                    <p class="text-sm text-slate-500 mb-6">Take a comprehensive 4-skill evaluation test structured around TOEIC standards and general corporate management.</p>

                    <div id="testContainer" class="space-y-6">
                        <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 text-center py-10">
                            <i class="fa-solid fa-clipboard-check text-4xl text-indigo-500 mb-3"></i>
                            <h4 class="font-bold text-slate-800 mb-2">Ready for your Monthly Evaluation?</h4>
                            <p class="text-sm text-slate-600 max-w-md mx-auto mb-4">This test covers intensive Business Reading, Corporate Writing, Translation, and Professional Speaking scenarios.</p>
                            <button onclick="startMonthlyTest()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-5 py-2.5 rounded-lg transition text-sm">
                                Start Full Assessment Now
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. VOCABULARY NOTEBOOK VIEW -->
            <section id="view-notebook" class="hidden space-y-6">
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
                    <div class="flex justify-between items-center mb-4">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Business & HR Vocabulary Notebook</h3>
                            <p class="text-sm text-slate-500">Review words saved during your practice sessions.</p>
                        </div>
                        <button onclick="openAddWordModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold px-3 py-2 rounded-lg transition">
                            + Add Custom Word
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm text-slate-600">
                            <thead class="bg-slate-50 text-slate-700 uppercase text-xs font-semibold border-b border-slate-200">
                                <tr>
                                    <th class="py-3 px-4">Word / Term</th>
                                    <th class="py-3 px-4">Meaning & Context</th>
                                    <th class="py-3 px-4">Category</th>
                                    <th class="py-3 px-4 text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="vocabTableBody" class="divide-y divide-slate-100"></tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- QUICK LOOKUP MODAL -->
    <div id="quickLookupModal" class="hidden fixed inset-0 bg-slate-900/40 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-5 space-y-4">
            <div class="flex justify-between items-start border-b border-slate-100 pb-3">
                <div>
                    <h4 id="lookupWord" class="text-xl font-bold text-indigo-700">Word</h4>
                    <span id="lookupPhonetic" class="text-xs text-slate-400 font-mono">/phonetic/</span>
                </div>
                <button onclick="closeModal('quickLookupModal')" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div id="lookupDefinitionContainer" class="text-sm text-slate-700 space-y-2">
                <p class="text-xs text-slate-400">Fetching definition...</p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex justify-between items-center">
                <a id="cambridgeLink" href="#" target="_blank" class="text-xs text-indigo-600 hover:underline flex items-center font-medium">
                    View on Cambridge Dictionary <i class="fa-solid fa-arrow-up-right-from-square ms-1 text-[10px]"></i>
                </a>
                <button onclick="saveCurrentLookupToNotebook()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-1.5 rounded transition">
                    Save to Notebook
                </button>
            </div>
        </div>
    </div>

    <!-- API KEY MODAL -->
    <div id="apiKeyModal" class="hidden fixed inset-0 bg-slate-900/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-xl max-w-md w-full p-6 space-y-4">
            <h3 class="text-lg font-bold text-slate-800">Google AI Studio Settings</h3>
            <p class="text-xs text-slate-500">Enter your Gemini API Key. Stored securely in your browser's local storage.</p>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Gemini API Key</label>
                <input type="password" id="apiKeyInput" placeholder="AIzaSy..." class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
            </div>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeModal('apiKeyModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Cancel</button>
                <button onclick="saveApiKey()" class="px-4 py-2 text-xs font-semibold bg-indigo-600 text-white hover:bg-indigo-700 rounded-lg">Save Key</button>
            </div>
        </div>
    </div>

    <!-- APPLICATION JAVASCRIPT -->
