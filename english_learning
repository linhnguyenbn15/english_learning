<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-graduation-cap text-2xl text-yellow-300"></i>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Business & TOEIC English Pro</h1>
                    <p class="text-xs text-indigo-200">Advanced B1 &rarr; C1 Roadmap (TOEIC Standard & Mixed HR Vocab)</p>
                </div>
            </div>

            <div class="flex items-center space-x-3">
                <div class="bg-indigo-800 px-3 py-1.5 rounded-full flex items-center text-xs font-semibold text-amber-300 border border-indigo-600">
