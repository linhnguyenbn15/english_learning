                <button onclick="exportData()" title="Export JSON" class="bg-indigo-600 hover:bg-indigo-500 text-xs p-1.5 rounded transition">
                    <i class="fa-solid fa-download"></i>
                </button>
                <label title="Import JSON" class="bg-indigo-600 hover:bg-indigo-500 text-xs p-1.5 rounded transition cursor-pointer">
                    <i class="fa-solid fa-upload"></i>
                    <input type="file" id="importFile" onchange="importData(event)" class="hidden" accept=".json">
                </label>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <div class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full flex flex-col md:flex-row gap-6">

        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 flex-shrink-0">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-4 sticky top-20">
                <nav class="space-y-1">
                    <button onclick="switchTab('dashboard')" id="nav-dashboard" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium transition bg-indigo-50 text-indigo-700">
                        <i class="fa-solid fa-chart-line w-5"></i>
                        <span>Dashboard</span>
                    </button>
                    <button onclick="switchTab('daily')" id="nav-daily" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                        <i class="fa-solid fa-book-open w-5"></i>
                        <span>Intensive Practice (5 Qs)</span>
                    </button>
                    <button onclick="switchTab('assessment')" id="nav-assessment" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                        <i class="fa-solid fa-file-pen w-5"></i>
                        <span>Monthly Test</span>
                    </button>
                    <button onclick="switchTab('notebook')" id="nav-notebook" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-50 transition">
                        <i class="fa-solid fa-bookmark w-5"></i>
                        <span>Vocab Notebook</span>
                    </button>
                </nav>

                <hr class="my-4 border-slate-100">

                <div class="bg-slate-50 rounded-lg p-3 border border-slate-200">
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-xs font-semibold text-slate-500 uppercase">Today's Target</span>
                        <span id="targetBadge" class="text-xs px-2 py-0.5 rounded font-bold bg-blue-100 text-blue-700">30 Min</span>
                    </div>
                    <p class="text-xs text-slate-600 mb-2" id="dayTypeLabel">Weekday Schedule</p>
                    <div class="w-full bg-slate-200 rounded-full h-2 mb-2">
                        <div id="studyProgressBar" class="bg-indigo-600 h-2 rounded-full" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between items-center text-xs text-slate-500">
                        <span id="timeStudiedText">0 mins completed</span>
                        <button onclick="addManualStudyTime(10)" class="text-indigo-600 hover:underline font-medium">+10m</button>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1">

            <!-- 1. DASHBOARD VIEW -->
            <section id="view-dashboard" class="space-y-6">
                <div class="bg-gradient-to-r from-indigo-600 to-violet-600 rounded-xl p-6 text-white shadow-sm flex justify-between items-center">
                    <div>
                        <h2 class="text-2xl font-bold mb-1">Welcome back, Professional!</h2>
                        <p class="text-indigo-100 text-sm">Target: Advanced TOEIC & Business English (B1 &rarr; C1)</p>
                    </div>
                    <div class="hidden sm:block text-right">
                        <p class="text-xs text-indigo-200 uppercase">Current Phase</p>
                        <p class="text-lg font-bold text-yellow-300" id="currentPhaseLabel">Phase 1: B1 &rarr; B2</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
