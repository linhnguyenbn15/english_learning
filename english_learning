                <button onclick="toggleModal('apiKeyModal')" class="bg-indigo-600 hover:bg-indigo-500 text-xs px-3 py-1.5 rounded flex items-center transition border border-indigo-400">
                    <i class="fa-solid fa-key me-1"></i> API Key
